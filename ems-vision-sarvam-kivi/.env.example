SARVAM_API_KEY=
# Leave empty locally. Set a long random value on any public deployment.
APP_ACCESS_TOKEN=
# Comma-separated site origins, for example https://your-site.vercel.app
CORS_ORIGINS=http://localhost:3000
# Set false on a public host.
ALLOW_PRIVATE_FEED_URLS=true
# Omit for local SQLite. Hosted: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
